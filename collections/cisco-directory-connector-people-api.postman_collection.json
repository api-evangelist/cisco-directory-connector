  "info": {
    "_postman_id": "456444cd-fd88-4c69-8137-a32624604bdc",
    "name": "Cisco Directory Connector Management API (via Webex & ) Groups People API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Cisco Directory Connector is an on-premises Windows service that\nsynchronizes users and groups from Active Directory or LDAP into Cisco\nWebex Control Hub. Programmatic management of the synced people and\ngroups uses the Webex People and Groups APIs at webexapis.com/v1.\nAuthentication uses OAuth 2.0 access tokens or service-app tokens\nscoped to the Webex organization.\n\n\nContact Support:\n Name: Webex for Developers",
      "type": "text/plain"
    }
  }

{
  "@context": {
    "@version": 1.1,
    "webex": "https://webexapis.com/v1/",
    "scim": "urn:ietf:params:scim:schemas:core:2.0:",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",

    "DirectorySyncJob": {
      "@id": "webex:DirectorySyncJob",
      "@context": {
        "id": "webex:id",
        "orgId": "webex:org_id",
        "status": "webex:status",
        "syncType": "webex:sync_type",
        "started": {
          "@id": "schema:startTime",
          "@type": "xsd:dateTime"
        },
        "completed": {
          "@id": "schema:endTime",
          "@type": "xsd:dateTime"
        },
        "usersAdded": "webex:users_added",
        "usersUpdated": "webex:users_updated",
        "usersDeleted": "webex:users_deleted",
        "errors": "webex:errors"
      }
    },

    "User": {
      "@id": "scim:User",
      "@context": {
        "id": "scim:id",
        "userName": "scim:userName",
        "displayName": "schema:name",
        "name": "scim:name",
        "emails": "schema:email",
        "active": "scim:active",
        "groups": "scim:groups",
        "phoneNumbers": "schema:telephone",
        "title": "schema:jobTitle",
        "externalId": "scim:externalId",
        "meta": "scim:meta"
      }
    },

    "Group": {
      "@id": "scim:Group",
      "@context": {
        "id": "scim:id",
        "displayName": "schema:name",
        "members": "scim:members",
        "externalId": "scim:externalId",
        "meta": "scim:meta"
      }
    },

    "AttributeMapping": {
      "@id": "webex:AttributeMapping",
      "@context": {
        "directoryAttribute": "webex:directory_attribute",
        "webexAttribute": "webex:webex_attribute",
        "transform": "webex:transform"
      }
    }
  }
}
